PORT=5000
MONGO_URI=mongodb+srv://<database-user>:<database-password>@<cluster-host>/bytemonk_portal?retryWrites=true&w=majority
MONGO_DB_NAME=bytemonk_portal
REDIS_URL=
ADMIN_API_KEYS=alice:replace-with-a-long-random-key,bob:replace-with-another-long-random-key
# ADMIN_API_KEY is for local development only; production requires separate named keys.
# Generate a separate 20-byte Base32 authenticator secret per organizer with `npm run secret:totp`.
ADMIN_TOTP_SECRETS=alice:<base32-secret>,bob:<base32-secret>
# Run `npm run setup:env` to generate this automatically, or `npm run secret` for your host.
ADMIN_SESSION_SECRET=replace-with-a-different-long-random-secret
ADMIN_SESSION_TTL_MINUTES=120
# Number of reverse proxies in front of the API (Render, Railway, Heroku, Nginx = 1). Leave 0 locally.
TRUST_PROXY=0
CLIENT_ORIGIN=http://localhost:5173
